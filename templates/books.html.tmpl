{{define "main" -}}
<header class="article-header">
  <h1>Books</h1>
  <p class="subtitle">What I've read over the last five years or so.</p>
</header>

<section class="books-dash">

  <!-- Hero: total books read -->
  <div class="hero-stat">
    <span class="hero-number">{{.Total}}</span>
    <span class="hero-label">books read</span>
    <span class="hero-sub">by {{.Authors}} authors across {{.GenreCount}} genres</span>
  </div>

  <!-- Charts: genre distribution + top authors -->
  <div class="books-charts">
    <figure class="books-chart">
      <figcaption class="chart-title">By genre</figcaption>
      {{.GenrePie}}
    </figure>
    <figure class="books-chart">
      <figcaption class="chart-title">Most-read authors</figcaption>
      {{.AuthorBar}}
    </figure>
  </div>

  <!-- Featured book, re-picked each build -->
  {{with .Featured}}
  <div class="featured">
    <span class="featured-kind">Featured</span>
    <h2 class="featured-title">{{.Title}}</h2>
    <p class="featured-meta">{{.Author}}{{if .Genre}} · <span class="featured-genre">{{.Genre}}</span>{{end}}</p>
    {{if .Notes}}<blockquote class="featured-notes">{{.Notes}}</blockquote>{{end}}
  </div>
  {{end}}

  <!-- Full list, collapsed by default -->
  <details class="books-table-wrap">
    <summary>Show the full list ({{.Total}} books)</summary>
    <div class="table-scroll">
      <table class="books-table">
        <thead>
          <tr><th>Title</th><th>Author</th><th>Genre</th><th>Notes</th></tr>
        </thead>
        <tbody>
          {{range .Rows}}
          <tr>
            <td class="bt-title">{{.Title}}</td>
            <td class="bt-author">{{.Author}}</td>
            <td class="bt-genre">{{.Genre}}</td>
            <td class="bt-notes">{{.Notes}}</td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
  </details>

</section>
{{- end}}
