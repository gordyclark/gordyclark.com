{{define "main" -}}
<article class="list-post">
  {{if .Hero}}
  <figure class="post-hero">
    <img src="{{.Hero}}" alt="{{.HeroAlt}}">
  </figure>
  {{end}}

  <header class="article-header">
    <div class="article-heading">
      <h1>{{.Title}}</h1>
      {{if .Subtitle}}<p class="subtitle">{{.Subtitle}}</p>{{end}}
    </div>
    {{.MetaCard}}
  </header>

  {{/* Auto-generated from the post's level-2 headings. Plain anchor links:
       following one is the reader's own click, so nothing moves the page on
       its own. */}}
  {{.TOC}}

  {{.ArticleHTML}}
</article>

{{if .Related}}
<section class="related">
  <h2>Related on this site</h2>
  <ul class="related-list">
    {{range .Related}}
    <li>
      <a class="margin-chip internal" href="{{.URL}}">
        <span class="domain"><span class="dot">&#9670;</span>On this site</span>
        <span class="chip-title">{{.Title}}</span>
        {{if .Subtitle}}<span class="chip-desc">{{.Subtitle}}</span>{{end}}
      </a>
    </li>
    {{end}}
  </ul>
</section>
{{end}}
{{- end}}
